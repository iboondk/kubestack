# Example settings for local dev only.
# This file holds no real credentials. Every value is a placeholder that starts with change-me.
# Copy it to .env and replace the values there. .env is git-ignored.
POSTGRES_PASSWORD=change-me-postgres
APP_DB_PASSWORD=change-me-app-db
JWT_SECRET=change-me-jwt-secret
OAUTH_CLIENT_ID=change-me-oauth-client-id
OAUTH_CLIENT_SECRET=change-me-oauth-client-secret
GRAFANA_ADMIN_PASSWORD=change-me-grafana
